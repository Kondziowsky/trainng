# ---------------------------------------------------------------------------
# Public Supabase configuration.
#
# Both values below are SAFE to ship in the client bundle. The anon key is a
# public, RLS-scoped key — it grants no access beyond what Row Level Security
# policies allow.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY (or any other secret) in this app.
# Anything prefixed with EXPO_PUBLIC_ is inlined into the JS bundle at build
# time and is readable by anyone who downloads the app.
#
# Where to find these: Supabase dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
